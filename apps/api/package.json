{
  "name": "@teardown/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono HTTP API and pg-boss worker for Teardown.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run --passWithNoTests",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:worker": "node --env-file=.env dist/worker.js",
    "fake-session": "tsx --env-file=.env scripts/fake-session.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@teardown/core": "workspace:*",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5",
    "@supabase/supabase-js": "^2.116.0",
    "openai": "^7.20.0",
    "pg-boss": "^12.33.2"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
