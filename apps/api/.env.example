# Copy to .env. Every variable is read once in src/config.ts and validated at startup.

PORT=3000

# Supabase project (Project Settings → API). The API verifies user JWTs against the project's
# JWKS endpoint, so the project must use asymmetric signing keys (default for new projects;
# older projects: Project Settings → JWT Keys → "Migrate JWT secret").
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The public (anon) key. Not used by the API itself; the extension and web app builds read it
# from here so there is one place to keep project settings.
SUPABASE_ANON_KEY=

# Postgres connection string: dashboard → Connect → "Session pooler" (port 5432).
# Use the pooler host, not db.<project-ref>.supabase.co: the direct host is IPv6-only and
# fails with ENOTFOUND on networks without IPv6. The pooler username is postgres.<project-ref>.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.supabase.com:5432/postgres

# OpenAI (platform.openai.com → API keys). Transcription and generation run through this key.
OPENAI_API_KEY=

# Where the web app lives; used for redirects (Stripe success, Notion callback).
WEB_APP_URL=http://localhost:5173
