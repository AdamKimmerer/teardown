{
  "name": "Teardown spike A: offscreen mic",
  "description": "Can an offscreen document record the microphone after permission is granted from a visible page?",
  "version": "0.0.1",
  "manifest_version": 3,
  "key": "",
  "permissions": ["offscreen", "sidePanel", "storage"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open spike A panel" }
}
