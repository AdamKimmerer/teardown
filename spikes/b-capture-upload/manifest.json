{
  "name": "Teardown spike B: capture → IndexedDB → signed upload",
  "description": "captureVisibleTab as PNG, store the Blob in IndexedDB, PUT it to a Supabase signed upload URL.",
  "version": "0.0.1",
  "manifest_version": 3,
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open spike B panel" }
}
