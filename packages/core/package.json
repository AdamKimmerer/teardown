{
  "name": "@teardown/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, session clock, marker insertion, crop math, and the API contract. Imported by api, extension, and web.",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
